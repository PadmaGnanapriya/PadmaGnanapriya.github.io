"],"H:\\A_Padma_Codes\\Web_Design\\A React projects\\PadmaGnanapriya.github.io\\src\\componenets\\Education.tsx",["80","81","82"],"import React from 'react';\r\nimport {useSelector} from \"react-redux\";\r\nimport {RootState} from \"../store/reducer/myReducer\";\r\nimport AOS from \"aos\";\r\nimport \"aos/dist/aos.css\";\r\nAOS.init();\r\n\r\nconst Education: React.FC = () => {\r\n  const isDark: boolean = useSelector((state: RootState) => state.isDark);\r\n\r\n  return (\r\n    <div className={isDark ? 'education-dark py-3 px-3 px-md-4 px-lg-5' : 'education py-3 px-3 px-md-4 px-lg-5'}>\r\n      <h1 id='education' className='pt-5 mt-2'>Education</h1>\r\n\r\n      <div data-aos=\"fade-up\">\r\n        <a href='https://www.kln.ac.lk/' target='_blank'><h3 className='text-left'>University of Kelaniya</h3></a>\r\n        <p className='text-left'>Since 2019 February I am learning software engineering. Currently in Level 2\r\n          maintaining the GPA at 3.33 out of 4.0\r\n        </p>\r\n        <br/>\r\n      </div>\r\n\r\n      <div data-aos=\"fade-up\">\r\n        <a href='https://www.ijse.lk/' target='_blank'><h3 className='text-left'>IJSE</h3></a>\r\n        <p className='text-left'>I followed the CMJD(Comprehensive Master Java Developer) Professional diploma.\r\n          I learnt modern software design and developing methodologies (architectural designs and using depth of\r\n          object orientation) in java, JavaFX, hibernate, Angular, NodeJs, etc.</p>\r\n        <br/>\r\n      </div>\r\n\r\n      <div data-aos=\"fade-up\">\r\n        <a href='https://www.mahindacollege.lk/' target='_blank'><h3 className='text-left'>Mahinda College Galle</h3>\r\n        </a>\r\n        <p className='text-left'> I did my O/Ls and A/Ls at Mahinda College, Galle. I got 7A s and 2B s for my OLs.\r\n          In 2017 I faced for A/L\r\n          examination in Physical Stream and obtained the following results;\r\n          <br/><span style={{color: \"red\"}}>&#9734;</span> Combined Maths - A\r\n          <br/><span style={{color: \"red\"}}>&#9734;</span> Physics - A\r\n          <br/><span style={{color: \"red\"}}>&#9734;</span> Chemistry - C\r\n          <br/><br/><b>Activities and Societies:</b>\r\n          <br/> I was an active member of the school's astronomy club, Buddhist association, Environmental\r\n          club and world organisation of scout moment, and I was an outstanding player in the school's chess team.</p>\r\n        <br/>\r\n      </div>\r\n\r\n      <div data-aos=\"fade-up\">\r\n        <a href='https://www.facebook.com/polpagodadharmapalacollege'><h3 className='text-left'>Polpagoda Darmapala MV.\r\n        </h3></a>\r\n        <p className='text-left'>I passed the grade 5 scholarship exam at Polpogoda Dharmapala MV and I entered to\r\n          Mahinda College Galle.</p>\r\n      </div>\r\n\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Education;\r\n","H:\\A_Padma_Codes\\Web_Design\\A React projects\\PadmaGnanapriya.github.io\\src\\componenets\\About.tsx",[],"H:\\A_Padma_Codes\\Web_Design\\A React projects\\PadmaGnanapriya.github.io\\src\\componenets\\Contact.tsx",[],"H:\\A_Padma_Codes\\Web_Design\\A React projects\\PadmaGnanapriya.github.io\\src\\componenets\\Projects.tsx",["83","84","85","86"],"H:\\A_Padma_Codes\\Web_Design\\A React projects\\PadmaGnanapriya.github.io\\src\\componenets\\Home.tsx",[],"H:\\A_Padma_Codes\\Web_Design\\A React projects\\PadmaGnanapriya.github.io\\src\\componenets\\Header.tsx",[],"H:\\A_Padma_Codes\\Web_Design\\A React projects\\PadmaGnanapriya.github.io\\src\\componenets\\Skills.tsx",[],"H:\\A_Padma_Codes\\Web_Design\\A React projects\\PadmaGnanapriya.github.io\\src\\componenets\\Articles.tsx",["87"],"H:\\A_Padma_Codes\\Web_Design\\A React projects\\PadmaGnanapriya.github.io\\src\\componenets\\Footer.tsx",["88","89","90","91","92","93","94","95"],"import React from 'react';\r\nimport {Col, Row} from \"react-bootstrap\";\r\n\r\nconst Footer: React.FC = () => {\r\n  return (\r\n      <div className='py-3 bg-dark footer'>\r\n        <Row className=\"m-0\">\r\n          <Col className=\"social-media py-1 py-sm-3\">\r\n            <a href=\"https://www.linkedin.com/in/padma-gnanapriya-16b515180/\" target=\"_blank\" className=\"fa fa-linkedin\"/>\r\n            <a href=\"https://www.facebook.com/padma.gnanapriya/\" target=\"_blank\" className=\"fa fa-facebook\"/>\r\n            <a href=\"https://padmaisuru.medium.com/\" target=\"_blank\" className=\"fa fa-medium\"/>\r\n            <a href=\"https://github.com/PadmaGnanapriya\" target=\"_blank\" className=\"fa fa-github\"/>\r\n          </Col>\r\n\r\n        </Row>\r\n        <span className='text-light'>© Designed and Developed by Padma Gnanapriya</span>\r\n\r\n      </div>\r\n  );\r\n}\r\n\r\nexport default Footer;\r\n","H:\\A_Padma_Codes\\Web_Design\\A React projects\\PadmaGnanapriya.github.io\\src\\componenets\\SlideNav.tsx",[],"H:\\A_Padma_Codes\\Web_Design\\A React projects\\PadmaGnanapriya.github.io\\src\\componenets\\Achievements.tsx",["96"],"H:\\A_Padma_Codes\\Web_Design\\A React projects\\PadmaGnanapriya.github.io\\src\\store\\action\\storeAction.ts",[],"H:\\A_Padma_Codes\\Web_Design\\A React projects\\PadmaGnanapriya.github.io\\src\\types\\constants.ts",[],"H:\\A_Padma_Codes\\Web_Design\\A React projects\\PadmaGnanapriya.github.io\\src\\store\\index.ts",[],"H:\\A_Padma_Codes\\Web_Design\\A React projects\\PadmaGnanapriya.github.io\\src\\store\\reducer\\myReducer.ts",[],{"ruleId":"97","replacedBy":"98"},{"ruleId":"99","replacedBy":"100"},{"ruleId":"101","severity":1,"message":"102","line":4,"column":14,"nodeType":"103","messageId":"104","endLine":4,"endColumn":23},{"ruleId":"105","severity":1,"message":"106","line":17,"column":9,"nodeType":"107","endLine":17,"endColumn":58},{"ruleId":"105","severity":1,"message":"106","line":25,"column":9,"nodeType":"107","endLine":25,"endColumn":56},{"ruleId":"105","severity":1,"message":"106","line":33,"column":9,"nodeType":"107","endLine":33,"endColumn":