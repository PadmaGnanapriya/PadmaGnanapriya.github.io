ects/PadmaGnanapriya.github.io/src/index.tsx",[],["85","86"],"/home/padma/WebstormProjects/PadmaGnanapriya.github.io/src/reportWebVitals.ts",[],"/home/padma/WebstormProjects/PadmaGnanapriya.github.io/src/App.tsx",[],"/home/padma/WebstormProjects/PadmaGnanapriya.github.io/src/store/index.ts",[],"/home/padma/WebstormProjects/PadmaGnanapriya.github.io/src/componenets/About.tsx",[],"/home/padma/WebstormProjects/PadmaGnanapriya.github.io/src/componenets/Header.tsx",[],"/home/padma/WebstormProjects/PadmaGnanapriya.github.io/src/componenets/Education.tsx",[],"/home/padma/WebstormProjects/PadmaGnanapriya.github.io/src/componenets/Articles.tsx",[],"/home/padma/WebstormProjects/PadmaGnanapriya.github.io/src/componenets/Projects.tsx",[],"/home/padma/WebstormProjects/PadmaGnanapriya.github.io/src/componenets/SlideNav.tsx",[],"/home/padma/WebstormProjects/PadmaGnanapriya.github.io/src/componenets/Skills.tsx",[],"/home/padma/WebstormProjects/PadmaGnanapriya.github.io/src/componenets/Achievements.tsx",[],"/home/padma/WebstormProjects/PadmaGnanapriya.github.io/src/componenets/Contact.tsx",["87"],"import React, {ChangeEvent, FormEvent, useEffect, useState} from 'react';\nimport {Button, Card, Col, Form, OverlayTrigger, Row, Tooltip} from \"react-bootstrap\";\nimport {useSelector} from \"react-redux\";\nimport {RootState} from \"../store/reducer/myReducer\";\nimport AOS from \"aos\";\nimport \"aos/dist/aos.css\";\nimport publicIp from 'public-ip';\n\nAOS.init();\n\nconst Contact: React.FC = () => {\n  const isDark: boolean = useSelector((state: RootState) => state.isDark);\n  const [name, setName] = useState<string>('');\n  const [email, setEmail] = useState<string>('');\n  const [contact, setContact] = useState<string>('');\n  const [message, setMessage] = useState<string>('');\n  const [browser, setBrowser] = useState<string>(\"Undefined\");\n  const [address, setAddress] = useState<string>('');\n\n\n  useEffect(() => {\n    if (navigator.onLine) {\n      const getUA = () => {\n        let device = \"Unknown\";\n        const ua = {\n          \"Generic Linux\": /Linux/i,\n          \"Android\": /Android/i,\n          \"BlackBerry\": /BlackBerry/i,\n          \"Bluebird\": /EF500/i,\n          \"Chrome OS\": /CrOS/i,\n          \"Datalogic\": /DL-AXIS/i,\n          \"Honeywell\": /CT50/i,\n          \"iPad\": /iPad/i,\n          \"iPhone\": /iPhone/i,\n          \"iPod\": /iPod/i,\n          \"macOS\": /Macintosh/i,\n          \"Windows\": /IEMobile|Windows/i,\n          \"Zebra\": /TC70|TC55/i,\n        }\n        // @ts-ignore\n        Object.keys(ua).map(v => navigator.userAgent.match(ua[v]) && (device = v));\n        return device;\n      }\n\n      const BrowserDetect = () => {\n        if ((navigator.userAgent.indexOf(\"Opera\") || navigator.userAgent.indexOf('OPR')) !== -1) {\n          setBrowser('Opera');\n        } else if (navigator.userAgent.indexOf(\"Chrome\") !== -1) {\n          setBrowser('Chrome');\n        } else if (navigator.userAgent.indexOf(\"Safari\") !== -1) {\n          setBrowser('Safari');\n        } else if (navigator.userAgent.indexOf(\"Firefox\") !== -1) {\n          setBrowser('Firefox');\n        } else if ((navigator.userAgent.indexOf(\"MSIE\") !== -1)) {\n          setBrowser('IE');\n        }\n      }\n      BrowserDetect();\n      (async () => {\n        setAddress(await publicIp.v4());\n        await (\n          fetch(`https://docs.google.com/forms/d/e/1FAIpQLSeGernzdCiIhfkxreab4BFc15WG_9QLqnneBXc9d8RUfpFfyg/formResponse?entry.7345508=${address}&entry.98424334=country&entry.1201372642=city&entry.2060483585=${browser}&entry.900514976=PadmaReact&entry.1590939237=Location&entry.2078832264=${getUA()}&entry.2144518207=${navigator.platform}`, {\n            method: 'POST',\n            mode: 'no-cors',\n            headers: new Headers(),\n          }).then((res) => res.json())\n            .then(() => console.log(''))\n            .catch((err) => console.log(err))\n        )\n      })();\n    }\n    // console.clear();\n  }, [address])\n\n\n  const handleOnSubmit = async (event: FormEvent) => {\n    event.preventDefault();\n    event.stopPropagation();\n    if (email.slice(email.length - 3) !== 'com') {\n      alert(email.slice(3));\n      alert(\"Email is not correct\");\n      return;\n    }\n    const phoneno = /^[+]?[(]?[0-9]{3}[)]?[-\\s.]?[0-9]{3}[-\\s.]?[0-9]{4,6}$/im;\n    if (!contact.match(phoneno)) {\n      alert(\"Contact number is not correct\")\n      return;\n    }\n    await (\n      fetch(`https://docs.google.com/forms/d/e/1FAIpQLSeGernzdCiIhfkxreab4BFc15WG_9QLqnneBXc9d8RUfpFfyg/formResponse?entry.7345508=${address}&entry.98424334=${name}&entry.1201372642=${name}&entry.2060483585=${email}&entry.900514976=PadmaReact&entry.1590939237=${contact}&entry.2078832264=ooo&entry.2144518207=${message}`, {\n        method: 'POST',\n        mode: 'no-cors',\n        headers: new Headers(),\n      }).then((res) => res.json())\n        .then(() => console.log(''))\n        .catch((err) => console.log(err))\n    )\n\n    Array.from(document.querySelectorAll(\"input\")).forEach(\n      input => (input.value = \"\")\n    );\n\n    Array.from(document.querySelectorAll(\"textarea\")).forEach(\n      textarea => (textarea.value = \"\")\n    );\n  }\n\n\n  return (\n    <div className={isDark ? 'contact-dark py-3 px-3 px-md-4 px-lg-5' : 'contact-light py-3 px-3 px-md-4 px-lg-5'}>\n      <h1 className='pt-5 mt-2 pb-3'>Contact me</h1>\n      <Row className='m-0 p-0'>\n        <Col xs={12} lg={5} className='mx-0 p-0 my-1'>\n          <Card data-aos=\"zoom-in\" body id='contact' className='m-0'>\n            <Row className='mt-1'>\n              <Col className='text-left pl-4' xs={12} sm={4}>Email</Col>\n              <Col className='text-left pl-4' xs={12} sm={8}>\n                <OverlayTrigger placement=\"bottom\" delay={{show: 500, hide: 0}} overlay={<Tooltip id={\"-skill\"}>\n                  Click me to mail</Tooltip>}>\n                  <a href=\"mailto:padmaisuru@gmail.com\">padmaisuru@gmail.com</a>\n                </OverlayTrigger>\n              </Col>\n            </Row>\n            <Row className='mt-3'>\n              <Col className='text-left pl-4' xs={12} sm={4}>SMS</Col>\n              <Col className='text-left pl-4' xs={12} sm={8}>\n                <OverlayTrigger placement=\"bottom\" delay={{show: 500, hide: 0}} overlay={<Tooltip id={\"-skill\"}>\n                  Click me to sms</Tooltip>}>\n                  <a href=\"sms:+94766328189\">+94 766 328 189</a>\n                </OverlayTrigger>\n              </Col>\n            </Row>\n            <Row className='mt-3'>\n              <Col className='text-left pl-4' xs={12} sm={4}>Call</Col>\n              <Col className='text-left pl-4' xs={12} sm={8}>\n                <OverlayTrigger placement=\"bottom\" delay={{show: 500, hide: 0}} overlay={<Tooltip id={\"-skill\"}>\n                  Click me to call</Tooltip>}>\n                  <a href=\"tel:+94766328189\">+94 766 328 189</a>\n                </OverlayTrigger>\n              </Col>\n            </Row>\n            <Row className='mt-3'>\n              <Col className='text-left pl-4' xs={12} sm={4}>WhatsApp</Col>\n              <Col className='text-left pl-4' xs={12} sm={8}>\n                <OverlayTrigger placement=\"bottom\" delay={{show: 500, hide: 0}} overlay={<Tooltip id={\"-skill\"}>\n                  Click me to whatsApp</Tooltip>}>\n                  <a href=\"https://api.whatsapp.com/send?phone=+94766328189\">+94 766 328 189</a>\n                </OverlayTrigger>\n              </Col>\n            </Row>\n          </Card>\n        </Col>\n\n        <Col xs={12} lg={7} className='mx-0 p-0  my-1'>\n          <Card data-aos=\"zoom-in\" className='m-0 ml-lg-2 p-2'>\n            <Form onSubmit={handleOnSubmit}>\n              <Row>\n                <Col xs={12} className=\"styled-input\">\n                  <input id='username' type=\"text\" onChange={(e: ChangeEvent<HTMLInputElement>) =>\n                    setName(e.target.value)} required/>\n                  <label htmlFor='username'>Name</label>\n                  <span/>\n                </Col>\n                <Col xs={12} className=\"styled-input\">\n                  <input id='user-email' type=\"email\" onChange={(e: ChangeEvent<HTMLInputElement>) =>\n                    setEmail(e.target.value)} required/>\n                  <label htmlFor='user-email'>Email</label>\n                  <span/>\n                </Col>\n                <Col xs={12} className=\"styled-input\">\n                  <input id='user-number' type=\"text\" onChange={(e: ChangeEvent<HTMLInputElement>) =>\n                    setContact(e.target.value)} required/>\n                  <label htmlFor='user-number'>Contact Number</label>\n                  <span/>\n                </Col>\n                <Col xs={12} className=\"styled-input wide\">\n                  <textarea id='user-message' onChange={(e: ChangeEvent<HTMLTextAreaElement>) =>\n                    setMessage(e.target.value)} required/>\n                  <label htmlFor='user-message'>Message</label>\n                  <span/>\n                </Col>\n                <Col xs={12}>\n                  <Button type='submit' className='px-5 py-2 mb-3' variant={isDark ? 'dark' : 'info'}>\n                    Post to Padma</Button>\n                </Col>\n              </Row>\n            </Form>\n          </Card>\n        </Col>\n      </Row>\n    </div>\n  );\n}\nexport default Contact;\n","/home/padma/WebstormProjects/PadmaGnanapriya.github.io/src/componenets/Footer.tsx",[],"/home/padma/WebstormProjects/PadmaGnanapriya.github.io/src/componenets/Home.tsx",[],"/home/padma/WebstormProjects/PadmaGnanapriya.github.io/src/store/reducer/myReducer.ts",[],"/home/padma/WebstormProjects/PadmaGnanapriya.github.io/src/store/action/storeAction.ts",[],"/home/padma/WebstormProjects/PadmaGnanapriya.github.io/src/componenets/SocialIcon.tsx",[],"/home/padma/WebstormProjects/PadmaGnanapriya.github.io/src/componenets/Project.tsx",[],"/home/padma/WebstormProjects/PadmaGnanapriya.github.io/src/types/constants.ts",[],["88","89"],{"ruleId":"90","replacedBy":"91"},{"ruleId":"92","replacedBy":"93"},{"ruleId":"94","severity":1,"message":"95","line":73,"column":6,"nodeType":"96","endLine":73,"endColumn":15,"suggestions":"97"},{"ruleId":"90","replacedBy":"98"},{"ruleId":"92","replacedBy":"99"},"no-native-reassign",["100"],"no-negated-in-lhs",["101"],"react-hooks/exhaustive-deps","React Hook useEffect has a missing dependency: 'browser'. Either include it or remove the dependency array.","ArrayExpression",["102"],["100"],["101"],"no-global-assign","no-unsafe-negation",{"desc":"103","fix":"104"},"Update the dependencies array to be: [address, browser]",{"range":"105","text":"106"},[2796,2805],"[address, browser]"]